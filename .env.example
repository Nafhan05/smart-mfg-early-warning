# ============================================================
# Konfigurasi LLM Agent (opsional)
# ------------------------------------------------------------
# Tanpa API key, agent memakai fallback deterministic — sistem
# tetap berjalan penuh. Default provider: openai.
#
# Cukup aktifkan salah satu blok di bawah sesuai key yang Anda
# miliki (hapus tanda #).
# ============================================================

# --- Opsi 1: OpenAI (default) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-3.5-turbo

# --- Opsi 2: Gemini ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.0-flash

# --- Opsi 3: DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# --- Opsi 4: OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# --- Opsi 5: Endpoint OpenAI-compatible custom (misal opencode Zen/Go) ---
# LLM_PROVIDER=custom
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Fallback lama (tetap didukung): OPENAI_API_KEY

# ============================================================
# Konfigurasi model & dataset (path dipakai saat run lokal)
# ============================================================
MODEL_PATH=../model/model.pkl
DATA_PATH=../data/processed/dataset_ready.csv
SECTOR=makanan-minuman