# LLM API Configuration (opsional)
# Tanpa API key, agent menggunakan fallback deterministic.
#
# Pilih provider: openai | gemini | deepseek | openrouter | opencode | custom
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-3.5-turbo
# LLM_BASE_URL=https://api.openai.com/v1

# Provider opencode (OpenCode Zen/Go, OpenAI-compatible):
#   LLM_PROVIDER=opencode
#   LLM_API_KEY=sk-...
#   LLM_MODEL=deepseek-v4-flash
#   (base URL default: https://opencode.ai/zen/go/v1)

# Fallback lama (tetap didukung): OPENAI_API_KEY

# Konfigurasi model & dataset
MODEL_PATH=../model/model.pkl
DATA_PATH=../data/processed/dataset_ready.csv
SECTOR=makanan-minuman
